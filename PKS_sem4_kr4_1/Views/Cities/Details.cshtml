@model TouristGuide.Models.City

<h1>@Model.Name</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <img src="@Model.PhotoPath" class="img-fluid" alt="@Model.Name" 
             onerror="this.src='/images/placeholder.jpg'" />
        @if (!string.IsNullOrEmpty(Model.CoatOfArmsPath))
        {
            <h5 class="mt-3">Герб города</h5>
            <img src="@Model.CoatOfArmsPath" class="img-fluid" alt="Герб @Model.Name" 
                 onerror="this.src='/images/placeholder.jpg'" style="max-height: 200px;" />
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Регион:</dt>
            <dd class="col-sm-8">@Model.Region</dd>

            <dt class="col-sm-4">Население:</dt>
            <dd class="col-sm-8">@Model.Population.ToString("N0") чел.</dd>

            <dt class="col-sm-4">История:</dt>
            <dd class="col-sm-8">@Model.History</dd>
        </dl>
    </div>
</div>

<h2 class="mt-4">Достопримечательности</h2>
<div class="row">
    @if (Model.Attractions.Any())
    {
        @foreach (var attraction in Model.Attractions)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <img src="@attraction.PhotoPath" class="card-img-top" alt="@attraction.Name" 
                         onerror="this.src='/images/placeholder.jpg'" />
                    <div class="card-body">
                        <h5 class="card-title">@attraction.Name</h5>
                        <p class="card-text">@attraction.History?.Substring(0, Math.Min(attraction.History.Length, 150))...</p>
                        <a asp-controller="Attractions" asp-action="Details" asp-route-id="@attraction.Id" 
                           class="btn btn-outline-primary">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p>Достопримечательности не добавлены.</p>
    }
</div>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">Назад к списку городов</a>