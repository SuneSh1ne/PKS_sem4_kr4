@model IEnumerable<PKS_sem4_kr4_2.Models.WorkOrder>
@{
    ViewData["Title"] = "Производственные заказы";
}

<div class="page-header">
    <h1>📋 Производственные заказы</h1>
    <button class="btn btn-primary" onclick="showCreateModal()">+ Новый заказ</button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Фильтры -->
<div class="filters-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>Статус:</label>
            <select name="status" class="form-control" onchange="this.form.submit()">
                <option value="">Все заказы</option>
                <option value="active" selected="@(ViewBag.CurrentStatus == "active")">Активные</option>
                <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Ожидают</option>
                <option value="InProgress" selected="@(ViewBag.CurrentStatus == "InProgress")">В процессе</option>
                <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Завершены</option>
                <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Отменены</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Дата:</label>
            <select name="date" class="form-control" onchange="this.form.submit()">
                <option value="">Все даты</option>
                <option value="today" selected="@(ViewBag.CurrentDate == "today")">На сегодня</option>
                <option value="overdue" selected="@(ViewBag.CurrentDate == "overdue")">Просроченные</option>
            </select>
        </div>
    </form>
</div>

<!-- Таблица заказов -->
<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Номер</th>
                <th>Продукт</th>
                <th>Количество</th>
                <th>Линия</th>
                <th>Начало</th>
                <th>Окончание</th>
                <th>Статус</th>
                <th>Прогресс</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var isOverdue = order.Status != "Completed" && order.Status != "Cancelled" 
                             && order.Status != "Pending"
                             && order.EstimatedEndDate < DateTime.Now;
                <tr class="@(isOverdue ? "low-stock-row" : "")" data-order-id="@order.Id">
                    <td><strong>#@order.Id</strong></td>
                    <td>
                        <a href="/WorkOrders/Details/@order.Id" class="product-link">@order.Product?.Name</a>
                    </td>
                    <td>@order.Quantity шт.</td>
                    <td>@(order.ProductionLine?.Name ?? "Не назначена")</td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @order.StartDate.ToString("dd.MM.yyyy HH:mm")
                        }
                    </td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @order.EstimatedEndDate.ToString("dd.MM.yyyy HH:mm")
                        }
                        @if (isOverdue)
                        {
                            <br /><span class="text-danger fw-bold">⚠️ Просрочен!</span>
                        }
                    </td>
                    <td class="status-cell" data-order-id="@order.Id">
                        <span class="status-badge status-@order.Status.ToLower()">
                            @switch (order.Status)
                            {
                                case "Pending": <text>⏳ Ожидает</text> break;
                                case "InProgress": <text>⚙️ В процессе</text> break;
                                case "Completed": <text>✅ Завершён</text> break;
                                case "Cancelled": <text>❌ Отменён</text> break;
                            }
                        </span>
                    </td>
                    <td>
                        @if (order.Status == "InProgress")
                        {
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @order.ProgressPercent%" data-order-id="@order.Id"></div>
                                <span class="progress-text" data-order-id="@order.Id">@order.ProgressPercent%</span>
                            </div>
                        }
                        else if (order.Status == "Completed")
                        {
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 100%"></div>
                                <span>100%</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="action-buttons">
                        <a href="/WorkOrders/Details/@order.Id" class="btn btn-sm btn-info">📋</a>
                        
                        @if (order.Status == "Pending")
                        {
                            <button class="btn btn-sm btn-success" onclick="startOrder(@order.Id)">
                                ▶️ Запустить
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="cancelOrder(@order.Id)">
                                ❌ Отменить
                            </button>
                        }
                        
                        @if (order.Status == "InProgress")
                        {
                            <button class="btn btn-sm btn-danger" onclick="cancelOrder(@order.Id)">
                                ⏹️ Остановить
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Модальное окно создания заказа -->
<div id="createModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h2>Создать новый заказ</h2>
            <span class="close" onclick="closeModal('createModal')">&times;</span>
        </div>
        <form method="post" action="/WorkOrders/Create">
            <div class="form-group">
                <label>Продукт</label>
                <select name="productId" id="createProductId" class="form-control" required>
                    <option value="">Выберите продукт...</option>
                </select>
            </div>
            <div class="form-group">
                <label>Количество</label>
                <input type="number" name="quantity" id="createQuantity" class="form-control" min="1" required />
            </div>
            <div class="form-group">
                <label>Производственная линия (опционально)</label>
                <select name="productionLineId" id="createLineId" class="form-control">
                    <option value="">Выберите линию...</option>
                </select>
                <small class="text-muted">Линию можно назначить позже при запуске</small>
            </div>
            
            <button type="submit" class="btn btn-primary">Создать заказ</button>
        </form>
    </div>
</div>

<script>
    let autoRefreshInterval;

    document.addEventListener('DOMContentLoaded', function() {
        loadProducts();
        loadAvailableLines();
        autoRefreshInterval = setInterval(updateProgressBars, 5000);
    });

    window.addEventListener('beforeunload', function() {
        if (autoRefreshInterval) clearInterval(autoRefreshInterval);
    });

    function loadProducts() {
        fetch('/api/products/list')
            .then(response => response.json())
            .then(products => {
                const select = document.getElementById('createProductId');
                select.innerHTML = '<option value="">Выберите продукт...</option>';
                products.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = `${p.name} (${p.productionTimePerUnit} мин/шт)`;
                    select.appendChild(option);
                });
            });
    }

    function loadAvailableLines() {
        fetch('/api/lines/available')
            .then(response => response.json())
            .then(lines => {
                const select = document.getElementById('createLineId');
                select.innerHTML = '<option value="">Выберите линию...</option>';
                lines.forEach(l => {
                    const option = document.createElement('option');
                    option.value = l.id;
                    option.textContent = `${l.name} (Эффективность: ${l.efficiencyFactor}x)`;
                    select.appendChild(option);
                });
            });
    }

    function updateProgressBars() {
        fetch('/api/workorders/active-progresses')
            .then(response => response.json())
            .then(orders => {
                orders.forEach(order => {
                    const progressBar = document.querySelector(`.progress-fill[data-order-id="${order.id}"]`);
                    const progressText = document.querySelector(`.progress-text[data-order-id="${order.id}"]`);
                    const statusCell = document.querySelector(`.status-cell[data-order-id="${order.id}"]`);
                    
                    if (progressBar) {
                        progressBar.style.width = order.progressPercent + '%';
                    }
                    if (progressText) {
                        progressText.textContent = order.progressPercent + '%';
                    }
                    if (statusCell && order.status === 'Completed') {
                        statusCell.innerHTML = '<span class="status-badge status-completed">✅ Завершён</span>';
                        const actionCell = statusCell.closest('tr').querySelector('.action-buttons');
                        if (actionCell) {
                            actionCell.innerHTML = '<a href="/WorkOrders/Details/' + order.id + '" class="btn btn-sm btn-info">📋</a>';
                        }
                    }
                });
            })
            .catch(error => console.log('Ошибка обновления:', error));
    }

    function showCreateModal() {
        document.getElementById('createModal').style.display = 'block';
    }

    function startOrder(orderId) {
        if (confirm('Запустить заказ #' + orderId + ' в производство? Материалы будут списаны со склада.')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/WorkOrders/StartOrder';
            
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'orderId';
            input.value = orderId;
            
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    }

    function cancelOrder(orderId) {
        var message = 'Отменить заказ #' + orderId + '?';
        if (confirm(message)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/WorkOrders/CancelOrder';
            
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'orderId';
            input.value = orderId;
            
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.style.display = 'none';
        }
    }
</script>

<style>
    .calculation-info {
        background: #e8eaf6;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
    }
    .info-row strong {
        color: #1a237e;
    }
</style>