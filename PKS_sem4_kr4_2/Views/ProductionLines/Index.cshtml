@model IEnumerable<PKS_sem4_kr4_2.Models.ProductionLine>
@{
    ViewData["Title"] = "Производственные линии";
}

<div class="page-header">
    <h1>⚙️ Производственные линии</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="lines-grid">
    @foreach (var line in Model)
    {
        var efficiencyStr = line.EfficiencyFactor.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        
        <div class="line-card @(line.Status == "Active" ? "line-active" : "line-stopped")" data-line-id="@line.Id">
            <div class="line-header">
                <h3>@line.Name</h3>
                <span class="status-badge @(line.Status == "Active" ? "status-inprogress" : "status-cancelled")">
                    @(line.Status == "Active" ? "🟢 Работает" : "🔴 Остановлена")
                </span>
            </div>

            <div class="line-body">
                <!-- Текущий заказ -->
                <div class="line-info">
                    <strong>Текущий заказ:</strong>
                    @if (line.CurrentWorkOrder != null)
                    {
                        <div class="current-order">
                            <span>@line.CurrentWorkOrder.Product?.Name</span>
                            <span class="text-muted">(#@line.CurrentWorkOrder.Id)</span>
                            <div class="progress-bar" style="width: 100%; margin-top: 10px;">
                                <div class="progress-fill" style="width: @line.CurrentWorkOrder.ProgressPercent%"></div>
                                <span>@line.CurrentWorkOrder.ProgressPercent%</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Нет активного заказа</span>
                    }
                </div>

                <!-- Коэффициент эффективности -->
                <div class="line-info">
                    <strong>Эффективность:</strong>
                    <div class="efficiency-control">
                        <span class="efficiency-value @(line.EfficiencyFactor >= 1 ? "text-success" : line.EfficiencyFactor <= 0.3 ? "text-danger" : "text-warning")" id="efficiency-value-@line.Id">
                            @efficiencyStr x
                        </span>
                        <div class="efficiency-buttons">
                            <button type="button" class="btn btn-sm btn-success efficiency-btn" 
                                    data-line-id="@line.Id" 
                                    data-current="@efficiencyStr" 
                                    data-delta="0.1">➕</button>
                            <button type="button" class="btn btn-sm btn-warning efficiency-btn" 
                                    data-line-id="@line.Id" 
                                    data-current="@efficiencyStr" 
                                    data-delta="-0.1">➖</button>
                        </div>
                    </div>
                    <small class="text-muted">Диапазон: 0.1 — 2.0 | Шаг: 0.1</small>
                </div>

                <!-- Ближайшие заказы -->
                <div class="line-info">
                    <strong>Назначенные заказы:</strong>
                    @if (line.WorkOrders != null && line.WorkOrders.Any(w => w.Status == "Pending" || w.Status == "InProgress"))
                    {
                        <ul class="order-list">
                            @foreach (var order in line.WorkOrders.Where(w => w.Status == "Pending" || w.Status == "InProgress").Take(3))
                            {
                                <li>
                                    <span>#@order.Id - @order.Product?.Name</span>
                                    <span class="text-muted">(@order.Quantity шт.)</span>
                                    <span class="status-badge status-@order.Status.ToLower()">@order.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Нет назначенных заказов</span>
                    }
                </div>
            </div>

            <div class="line-footer">
                @if (line.Status == "Active")
                {
                    <button type="button" class="btn btn-danger btn-sm status-btn" data-line-id="@line.Id" data-status="Stopped">
                        ⏹️ Остановить
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-success btn-sm status-btn" data-line-id="@line.Id" data-status="Active">
                        ▶️ Запустить
                    </button>
                }
                <a href="/ProductionLines/Schedule/@line.Id" class="btn btn-info btn-sm">
                    📅 Расписание
                </a>
            </div>
        </div>
    }
</div>

<script>
    // Навешиваем обработчики после загрузки страницы
    document.addEventListener('DOMContentLoaded', function() {
        
        // Кнопки изменения эффективности
        document.querySelectorAll('.efficiency-btn').forEach(function(button) {
            button.addEventListener('click', function() {
                var lineId = parseInt(this.getAttribute('data-line-id'));
                var currentValue = parseFloat(this.getAttribute('data-current'));
                var delta = parseFloat(this.getAttribute('data-delta'));
                
                // Вычисляем новое значение
                var newValue = currentValue + delta;
                
                // Округляем до одного знака после запятой
                newValue = Math.round(newValue * 10) / 10;
                
                // Ограничиваем: минимум 0.1, максимум 2.0
                newValue = Math.max(0.1, Math.min(2.0, newValue));
                
                // Если значение не изменилось — выходим
                if (newValue === currentValue) {
                    return;
                }
                
                // Отправляем форму
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/ProductionLines/UpdateEfficiency';
                
                var input1 = document.createElement('input');
                input1.type = 'hidden';
                input1.name = 'lineId';
                input1.value = lineId;
                form.appendChild(input1);
                
                var input2 = document.createElement('input');
                input2.type = 'hidden';
                input2.name = 'efficiencyFactorStr';
                // Используем toFixed(1) — всегда даёт строку с точкой
                input2.value = newValue.toFixed(1);
                form.appendChild(input2);
                
                document.body.appendChild(form);
                form.submit();
            });
        });
        
        // Кнопки изменения статуса
        document.querySelectorAll('.status-btn').forEach(function(button) {
            button.addEventListener('click', function() {
                var lineId = this.getAttribute('data-line-id');
                var status = this.getAttribute('data-status');
                
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/ProductionLines/UpdateStatus';
                
                var input1 = document.createElement('input');
                input1.type = 'hidden';
                input1.name = 'lineId';
                input1.value = lineId;
                form.appendChild(input1);
                
                var input2 = document.createElement('input');
                input2.type = 'hidden';
                input2.name = 'status';
                input2.value = status;
                form.appendChild(input2);
                
                document.body.appendChild(form);
                form.submit();
            });
        });
    });
</script>

<style>
    .lines-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
        gap: 25px;
    }

    .line-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .line-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .line-active {
        border-top: 4px solid #43a047;
    }

    .line-stopped {
        border-top: 4px solid #e53935;
        opacity: 0.8;
    }

    .line-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        background: #f5f5f5;
    }

    .line-header h3 {
        margin: 0;
        color: #1a237e;
    }

    .line-body {
        padding: 20px;
    }

    .line-info {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

    .line-info:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .line-info strong {
        display: block;
        margin-bottom: 8px;
        color: #666;
    }

    .current-order {
        background: #e8f5e9;
        padding: 10px;
        border-radius: 8px;
    }

    .efficiency-control {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .efficiency-value {
        font-size: 1.5rem;
        font-weight: bold;
        min-width: 60px;
    }

    .efficiency-buttons {
        display: flex;
        gap: 8px;
    }

    .efficiency-btn {
        padding: 8px 16px !important;
        font-size: 1.1rem !important;
        cursor: pointer;
        border-radius: 6px !important;
        transition: all 0.2s;
    }

    .efficiency-btn:hover {
        transform: scale(1.1);
    }

    .order-list {
        list-style: none;
        padding: 0;
    }

    .order-list li {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: 0.9rem;
    }

    .line-footer {
        padding: 15px 20px;
        background: #fafafa;
        display: flex;
        gap: 10px;
    }

    .progress-bar {
        width: 100%;
        height: 24px;
        background-color: #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #43a047, #66bb6a);
        border-radius: 12px;
        transition: width 0.5s ease;
    }

    .progress-bar span {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.75rem;
        font-weight: bold;
        color: #333;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        display: inline-block;
    }

    .status-inprogress {
        background-color: #cce5ff;
        color: #004085;
    }

    .status-cancelled {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-completed {
        background-color: #d4edda;
        color: #155724;
    }

    .text-success { color: #43a047 !important; }
    .text-warning { color: #ff9800 !important; }
    .text-danger { color: #e53935 !important; }
    .text-muted { color: #78909c !important; }

    @@media only screen and (max-width: 768px) {
        .lines-grid {
            grid-template-columns: 1fr;
        }
    }
</style>