@model IEnumerable<PKS_sem4_kr4_2.Models.Product>
@{
    ViewData["Title"] = "Каталог продуктов";
}

<div class="page-header">
    <h1>📦 Каталог продуктов</h1>
    <button class="btn btn-primary" onclick="showAddModal()">+ Новый продукт</button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Фильтры -->
<div class="filters-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>Категория:</label>
            <select name="category" class="form-control" onchange="this.form.submit()">
                <option value="">Все категории</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat" selected="@(ViewBag.CurrentCategory == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Поиск:</label>
            <input type="text" name="search" class="form-control" placeholder="Название продукта..." value="@ViewBag.CurrentSearch" />
            <button type="submit" class="btn btn-primary">🔍</button>
        </div>
    </form>
</div>

<!-- Таблица продуктов -->
<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Время производства</th>
                <th>Категория</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        <span class="product-link">@product.Name</span>
                    </td>
                    <td>@product.ProductionTimePerUnit мин/шт</td>
                    <td><span class="category-badge">@product.Category</span></td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-warning" onclick="showEditModal(@product.Id, '@product.Name', '@product.Description', '@product.Category', @product.ProductionTimePerUnit)">
                                ✏️ Изменить
                            </button>
                            <a href="/Products/Delete/@product.Id" class="btn btn-sm btn-danger" onclick="return confirm('Удалить продукт?')">
                                🗑️
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Модальное окно добавления продукта -->
<div id="addModal" class="modal">
    <div class="modal-content" style="max-width: 700px;">
        <div class="modal-header">
            <h2>Новый продукт</h2>
            <span class="close" onclick="closeModal('addModal')">&times;</span>
        </div>
        <form method="post" action="/Products/Create">
            <div class="form-group">
                <label>Название</label>
                <input type="text" name="Name" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label>Категория</label>
                <input type="text" name="Category" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Время производства (мин/шт)</label>
                <input type="number" name="ProductionTimePerUnit" class="form-control" min="1" value="10" required />
            </div>
            
            <!-- Привязка материалов -->
            <div class="form-section">
                <h4>📎 Необходимые материалы</h4>
                <div id="addMaterialsList">
                    <div class="material-row">
                        <select name="materialIds" class="form-control" style="flex: 2;">
                            <option value="0">Выберите материал...</option>
                        </select>
                        <input type="number" name="quantities" class="form-control" placeholder="Кол-во на ед." step="0.01" min="0.01" style="flex: 1;" />
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">✕</button>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-secondary" onclick="addMaterialRow('addMaterialsList')">+ Добавить материал</button>
            </div>
            
            <button type="submit" class="btn btn-primary" style="margin-top: 15px;">Создать продукт</button>
        </form>
    </div>
</div>

<!-- Модальное окно редактирования -->
<div id="editModal" class="modal">
    <div class="modal-content" style="max-width: 700px;">
        <div class="modal-header">
            <h2>Редактировать продукт</h2>
            <span class="close" onclick="closeModal('editModal')">&times;</span>
        </div>
        <form method="post" action="/Products/Edit">
            <input type="hidden" name="Id" id="editProductId" />
            <div class="form-group">
                <label>Название</label>
                <input type="text" name="Name" id="editName" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" id="editDescription" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label>Категория</label>
                <input type="text" name="Category" id="editCategory" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Время производства (мин/шт)</label>
                <input type="number" name="ProductionTimePerUnit" id="editProdTime" class="form-control" min="1" required />
            </div>
            
            <!-- Редактирование материалов -->
            <div class="form-section">
                <h4>📎 Необходимые материалы</h4>
                <div id="editMaterialsList">
                </div>
                <button type="button" class="btn btn-sm btn-secondary" onclick="addMaterialRow('editMaterialsList')">+ Добавить материал</button>
            </div>
            
            <button type="submit" class="btn btn-warning" style="margin-top: 15px;">Сохранить</button>
        </form>
    </div>
</div>

<script>
    let allMaterials = [];

    document.addEventListener('DOMContentLoaded', function() {
        fetch('/api/materials/list')
            .then(response => response.json())
            .then(materials => {
                allMaterials = materials;
                updateAllMaterialSelects();
            });
    });

    function updateAllMaterialSelects() {
        document.querySelectorAll('select[name="materialIds"]').forEach(select => {
            const currentValue = select.value;
            select.innerHTML = '<option value="0">Выберите материал...</option>';
            allMaterials.forEach(m => {
                const option = document.createElement('option');
                option.value = m.id;
                option.textContent = `${m.name} (${m.unitOfMeasure})`;
                select.appendChild(option);
            });
            select.value = currentValue;
        });
    }

    function addMaterialRow(containerId) {
        const container = document.getElementById(containerId);
        const row = document.createElement('div');
        row.className = 'material-row';
        row.innerHTML = `
            <select name="materialIds" class="form-control" style="flex: 2;">
                <option value="0">Выберите материал...</option>
                ${allMaterials.map(m => `<option value="${m.id}">${m.name} (${m.unitOfMeasure})</option>`).join('')}
            </select>
            <input type="number" name="quantities" class="form-control" placeholder="Кол-во на ед." step="0.01" min="0.01" style="flex: 1;" />
            <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">✕</button>
        `;
        container.appendChild(row);
    }

    function removeMaterialRow(button) {
        const row = button.parentElement;
        const container = row.parentElement;
        if (container.children.length > 1) {
            row.remove();
        }
    }

    function showAddModal() {
        document.getElementById('addModal').style.display = 'block';
        const container = document.getElementById('addMaterialsList');
        container.innerHTML = `
            <div class="material-row">
                <select name="materialIds" class="form-control" style="flex: 2;">
                    <option value="0">Выберите материал...</option>
                    ${allMaterials.map(m => `<option value="${m.id}">${m.name} (${m.unitOfMeasure})</option>`).join('')}
                </select>
                <input type="number" name="quantities" class="form-control" placeholder="Кол-во на ед." step="0.01" min="0.01" style="flex: 1;" />
                <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">✕</button>
            </div>
        `;
    }

    function showEditModal(id, name, description, category, prodTime) {
        document.getElementById('editProductId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editDescription').value = description || '';
        document.getElementById('editCategory').value = category || '';
        document.getElementById('editProdTime').value = prodTime;
        
        fetch(`/api/products/${id}/materials`)
            .then(response => response.json())
            .then(productMaterials => {
                const container = document.getElementById('editMaterialsList');
                container.innerHTML = '';
                
                if (productMaterials.length > 0) {
                    productMaterials.forEach(pm => {
                        const row = document.createElement('div');
                        row.className = 'material-row';
                        row.innerHTML = `
                            <select name="materialIds" class="form-control" style="flex: 2;">
                                <option value="0">Выберите материал...</option>
                                ${allMaterials.map(m => `<option value="${m.id}" ${m.id == pm.materialId ? 'selected' : ''}>${m.name} (${m.unitOfMeasure})</option>`).join('')}
                            </select>
                            <input type="number" name="quantities" class="form-control" placeholder="Кол-во на ед." step="0.01" min="0.01" value="${pm.quantityNeeded}" style="flex: 1;" />
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">✕</button>
                        `;
                        container.appendChild(row);
                    });
                } else {
                    const row = document.createElement('div');
                    row.className = 'material-row';
                    row.innerHTML = `
                        <select name="materialIds" class="form-control" style="flex: 2;">
                            <option value="0">Выберите материал...</option>
                            ${allMaterials.map(m => `<option value="${m.id}">${m.name} (${m.unitOfMeasure})</option>`).join('')}
                        </select>
                        <input type="number" name="quantities" class="form-control" placeholder="Кол-во на ед." step="0.01" min="0.01" style="flex: 1;" />
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">✕</button>
                    `;
                    container.appendChild(row);
                }
            });
        
        document.getElementById('editModal').style.display = 'block';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.style.display = 'none';
        }
    }
</script>

<style>
    .form-row {
        display: flex;
        gap: 15px;
    }
    .form-row .form-group {
        flex: 1;
    }
    .form-section {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
    }
    .form-section h4 {
        margin-bottom: 10px;
        color: #1a237e;
    }
    .material-row {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }
</style>